# Copied to .env.hosted (gitignored). scripts/hosted-up.sh creates HOSTED_ENCRYPTION_KEY if missing.
# For local Docker hosted stack: add the same API keys you use for the EvoScientist CLI.

HOSTED_ENCRYPTION_KEY=

# Server-key LLM (default: Gemini 3 Flash via Google GenAI — see HOSTED_DEFAULT_LLM_* below)
GOOGLE_API_KEY=

# If you set HOSTED_DEFAULT_LLM_PROVIDER=anthropic instead, use:
# ANTHROPIC_API_KEY=

# Strongly recommended for literature-style / web-grounded runs (tavily_search tool)
TAVILY_API_KEY=

# Hosted flags (docker-compose.hosted.yml also sets these; override here if needed)
HOSTED_OPEN_MODE=true
HOSTED_USE_SERVER_KEYS=true

# Default model for server-key jobs (short name from EvoScientist llm/models.py)
# HOSTED_DEFAULT_LLM_MODEL=gemini-3-flash
# HOSTED_DEFAULT_LLM_PROVIDER=google-genai

# Dev-only: enable "Restart server" button in /ui (calls POST /admin/restart)
# HOSTED_ALLOW_UI_RESTART=true
